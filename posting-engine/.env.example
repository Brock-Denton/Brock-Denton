# Required: your Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model writes the posts. Defaults to claude-opus-5 (best voice).
# Cheaper options: claude-sonnet-5, claude-haiku-4-5
POST_MODEL=claude-opus-5

# --- X / Twitter (leave blank until you have a key; posting stays manual until then) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
